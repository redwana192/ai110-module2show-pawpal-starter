classDiagram
    Owner "1" o-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : owns
    Scheduler --> Owner : reads
    class Owner {
        name: str
        pets: list~Pet~
        add_pet(pet)
        all_tasks()
    }
    class Pet {
        name: str
        species: str
        tasks: list~Task~
        add_task(task)
    }
    class Task {
        description: str
        time: str
        due_date: date
        frequency: str
        completed: bool
        duration_minutes: int
        priority: str
        id: str
        mark_complete(completed_on)
    }
    class Scheduler {
        owner: Owner
        sort_by_time(tasks)
        filter_tasks(pet_name, completed, on_date)
        mark_task_complete(task_id, completed_on)
        detect_conflicts(on_date)
        build_plan(on_date, available_minutes)
    }
